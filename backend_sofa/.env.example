PORT=3050
NODE_ENV=development
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_HOST=localhost
DB_PORT=5433
DB_SSL=false

# --- Desarrollo (túnel SSM) ---
# aws ssm start-session --target "i-00022dbcb1ddd4206" --document-name AWS-StartPortForwardingSession --parameters '{"portNumber":["5432"],"localPortNumber":["5433"]}'
# Con el túnel activo: DB_HOST=localhost DB_PORT=5433 DB_NAME=sofascore2
# Alternativa por entorno: usa .env.development con DB_HOST_DEV/DB_PORT_DEV

# --- Producción (EC2 -> RDS directo) ---
# En el servidor crea backend_sofa/.env con NODE_ENV=production y:
# DB_HOST_PROD=<rds-endpoint> DB_PORT_PROD=5432 DB_SSL=false|true
# o simplemente DB_HOST=<rds-endpoint> DB_PORT=5432
