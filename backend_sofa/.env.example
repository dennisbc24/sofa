PORT=3050
NODE_ENV=development
DB_USER=postgres
DB_PASSWORD=
DB_NAME=sofa
DB_HOST=localhost
DB_PORT=5433
DB_SSL=false

# Sesiones web (obligatorio, mínimo 32 caracteres). Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=
# 1 = fuerza cookie Secure (solo HTTPS), 0 = la desactiva. Si se omite se
# detecta con req.secure / X-Forwarded-Proto (nginx debe enviar la cabecera).
AUTH_COOKIE_SECURE=

# Desarrollo via túnel SSM (EC2 i-00022dbcb1ddd4206):
# aws ssm start-session --target "i-00022dbcb1ddd4206" --document-name AWS-StartPortForwardingSession --parameters '{"portNumber":["5432"],"localPortNumber":["5433"]}'
# Con túnel: DB_HOST=localhost DB_PORT=5433 DB_NAME=sofa (credenciales en EC2 /home/ubuntu/proyects/sofa/backend_sofa/.env)
# Sin túnel (DB local): DB_NAME=sofascore2 DB_PORT=5432

# Producción EC2 (/home/ubuntu/proyects/sofa/backend_sofa/.env):
# NODE_ENV=production
# DB_USER=postgres
# DB_PASSWORD=<ver EC2 .env>
# DB_NAME=sofa
# DB_HOST=localhost
# DB_PORT=5432
